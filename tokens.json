{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Brand-accurate design tokens for the Saronic Live-Event Planning Tool, seeded from the official Saronic Press Kit (July 2026). Dark, high-contrast event theme tuned for 16:9 on-site projector/monitor displays, with a light print/invite variant for exported playbook and invite material. Scan-state tokens map 1:1 to QR check-in outcomes (valid / already scanned / tampered).",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.125,
          0.161
        ],
        "hex": "#162029"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.333,
          0.388,
          0.431
        ],
        "hex": "#55636e"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.298,
          0.624,
          0.847
        ],
        "hex": "#4c9fd8"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.965,
          0.98
        ],
        "hex": "#f2f6fa"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.047,
          0.078,
          0.106
        ],
        "hex": "#0c141b"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.118,
          0.165,
          0.208
        ],
        "hex": "#1e2a35"
      }
    },
    "steel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.616,
          0.655,
          0.686
        ],
        "hex": "#9da7af"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.153,
          0.761,
          0.506
        ],
        "hex": "#27c281"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.694,
          0
        ],
        "hex": "#f2b100"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.282,
          0.302
        ],
        "hex": "#e5484d"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo Expanded",
        "fontSize": {
          "value": 6,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo Expanded",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo Expanded",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo Expanded",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.1,
          "unit": "em"
        }
      }
    }
  }
}
