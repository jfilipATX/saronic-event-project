#!/usr/bin/env bash
# Pre-push secret audit. Blocks the push if anything key-shaped is found in the
# working tree or ANY commit in history.
#
# Install (not tracked by git, so this must be run once per clone):
#   ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#
# Bypass only with a deliberate --no-verify, which should be an eyebrow-raiser.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python_bin="$repo_root/.venv/bin/python"
[ -x "$python_bin" ] || python_bin="python3"

echo "pre-push: running secret audit…"
if ! "$python_bin" "$repo_root/scripts/audit_secrets.py"; then
  echo ""
  echo "PUSH BLOCKED: secret audit failed."
  echo "Publishing a key is one-way — rotate it rather than force-pushing over it."
  exit 1
fi

echo "pre-push: checking branch discipline…"
# Read the push spec from stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if ! "$python_bin" "$repo_root/scripts/check_branch_discipline.py" \
        "$local_ref" "$local_sha" "$remote_ref" "$remote_sha"; then
    echo ""
    echo "PUSH BLOCKED: branch-discipline gate failed (see above)."
    echo "Merge the branch into main (which passed sweep) instead of pushing"
    echo "behavioral commits directly to main. Bypass only with --no-verify."
    exit 1
  fi
done
