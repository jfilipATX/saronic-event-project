# ── Secrets — never commit ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# ── Database (generated at runtime) ──
*.db
*.sqlite
*.sqlite3

# ── Virtualenv ──
.venv/
venv/

# ── Generated exports ──
# generated/ is deliberately TRACKED: the exported playbooks and deck outlines
# are the evidence artifacts that show the tool actually ran. Only the transient
# real-Claude evidence directory is regenerated per pass.
/output/

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
