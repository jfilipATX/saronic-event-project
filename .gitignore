# ── Secrets — never commit ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# ── Database (generated at runtime) ──
*.db
*.sqlite
*.sqlite3

# ── Virtualenv ──
.venv/
venv/

# ── Generated exports ──
# generated/ is MOSTLY tracked: the exported playbooks, deck outlines, and
# generated/claude-pass/ are evidence artifacts showing the tool actually ran.
# But the per-event Visuals renders below are machine-regenerated on every
# Visuals page open — per-machine outputs that do NOT belong in version control.
/output/
# Per-event Visuals renders (PNG/JSON composites) are machine-regenerated on
# every Visuals page open — per-machine outputs that do NOT belong in version
# control and cause pull conflicts. The real evidence lives in
# generated/claude-pass/ and the exported playbook/deck files, which stay tracked.
generated/visuals/

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
