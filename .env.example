# ── Claude / Anthropic (server-side only) ──
# Your personal Anthropic API key. NEVER commit the real value.
ANTHROPIC_API_KEY=
# Optional: override the model alias. Defaults to a real claude-opus-4-* catalog id
# (the interview is graded on real Anthropic usage; do not point this at a proxy).
ANTHROPIC_MODEL=claude-opus-4-20250514
# Hard spend ceiling in USD for the build (default 250, leaving $50 of the $300 cap).
ANTHROPIC_SPEND_LIMIT=250

# ── Provider mode ──
# "mock" = offline seed data (default, free). "real" = live APIs + Claude.
PROVIDER_MODE=mock
# Set to 1 to let features call the real Claude API (opt-in; burns budget).
USE_REAL_CLAUDE=0

# ── Pexels stock imagery (feature #5, optional) ──
PEXELS_API_KEY=

# ── QR check-in signing (feature #6) ──
# Random secret used to HMAC-sign attendee check-in tokens (server-side only).
EVENT_SIGNING_SECRET=
